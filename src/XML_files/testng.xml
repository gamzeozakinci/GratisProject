<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full unattended regression suite: one <test> block per area, run in order.
     Run with: mvn test -DsuiteXmlFile=src/XML_files/testng.xml

     Sequential on purpose (no parallel="..."): PlaywrightFactory keeps the browser
     and page in plain static fields, not ThreadLocal, so parallel threads would
     fight over the same browser. Keep it sequential unless PlaywrightFactory
     goes back to ThreadLocal.

     AuthTests is not part of this suite: it blocks on a real OTP typed in by hand
     and can't run unattended. Run it separately with src/XML_files/auth.xml. -->
<suite name="Gratis.com Suite" verbose="1">

    <test name="Navigation">
        <classes>
            <class name="gratis.com.tests.NavigationTests"/>
        </classes>
    </test>

    <test name="Search">
        <classes>
            <class name="gratis.com.tests.SearchTests"/>
        </classes>
    </test>

    <test name="FilterSort">
        <classes>
            <class name="gratis.com.tests.FilterSortTests"/>
        </classes>
    </test>

    <test name="Catalog">
        <classes>
            <class name="gratis.com.tests.CatalogTests"/>
        </classes>
    </test>

    <test name="Cart">
        <classes>
            <class name="gratis.com.tests.CartTests"/>
        </classes>
    </test>

    <test name="Checkout">
        <classes>
            <class name="gratis.com.tests.CheckoutTests"/>
        </classes>
    </test>

</suite>
