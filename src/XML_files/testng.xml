<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- No parallel="..." here on purpose: PlaywrightFactory uses plain static fields, not
     ThreadLocal, so running <test> blocks in parallel would have multiple threads
     fighting over the same browser/page. Keep this suite sequential unless
     PlaywrightFactory goes back to ThreadLocal. -->
<suite name="Gratis.com Suite" verbose="1">

    <!-- Module 1: Auth - single phone+OTP flow covers both login and registration -->
    <test name="Auth">
        <classes>
            <class name="com.gratis.tests.AuthTests"/>
        </classes>
    </test>

    <!-- Module 2: Navigation & Header -->
    <test name="Navigation">
        <classes>
            <class name="com.gratis.tests.NavigationTests"/>
        </classes>
    </test>

    <!-- Module 3: Search, Sorting & Filtering -->
    <test name="SearchAndFiltering">
        <classes>
            <class name="com.gratis.tests.SearchTests"/>
            <class name="com.gratis.tests.FilterSortTests"/>
        </classes>
    </test>

    <!-- Module 4: Product Catalog (PLP/PDP) -->
    <test name="Catalog">
        <classes>
            <class name="com.gratis.tests.CatalogTests"/>
        </classes>
    </test>

    <!-- Module 5: Cart -->
    <test name="Cart">
        <classes>
            <class name="com.gratis.tests.CartTests"/>
        </classes>
    </test>

    <!-- Module 6: Checkout & Payment -->
    <test name="Checkout">
        <classes>
            <class name="com.gratis.tests.CheckoutTests"/>
            <class name="com.gratis.tests.OrderTests"/>
        </classes>
    </test>

</suite>
