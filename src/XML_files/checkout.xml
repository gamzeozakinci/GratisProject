<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Checkout area only (TC_028-030).
     Needs the saved login session: run SessionCaptureTests.captureLoggedInSession
     shortly before (the session lasts about 15 minutes).
     The tests stop at the payment modal: no card details are entered and no order
     is placed.
     Run with: mvn test -DsuiteXmlFile=src/XML_files/checkout.xml -->
<suite name="Gratis.com Checkout Suite" verbose="1">

    <test name="Checkout">
        <classes>
            <class name="gratis.com.tests.CheckoutTests"/>
        </classes>
    </test>

</suite>
