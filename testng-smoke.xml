<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Quick subset: just the Smoke-tagged cases (TC_001-005) for a fast sanity check.
     Run with: mvn test -DsuiteXmlFile=testng-smoke.xml -->
<suite name="Gratis.com Smoke Suite" verbose="1">
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.gratis.tests.RegistrationTests"/>
            <class name="com.gratis.tests.LoginTests"/>
        </classes>
    </test>
</suite>
