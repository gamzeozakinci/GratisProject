<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Gratis.com Suite" verbose="1" parallel="tests" thread-count="3">

    <!-- Module 1: Auth (Registration + Login) -->
    <test name="Auth">
        <classes>
            <class name="com.gratis.tests.RegistrationTests"/>
            <class name="com.gratis.tests.LoginTests"/>
        </classes>
    </test>

    <!-- Module 2: Navigation & Header (desktop viewport) -->
    <test name="DesktopNavigation">
        <parameter name="viewport" value="desktop"/>
        <classes>
            <class name="com.gratis.tests.NavigationTests">
                <methods>
                    <exclude name="mobileHamburgerMenuDrilldown"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- TC_007 needs the mobile breakpoint (<=768px) - isolated into its own <test>
         so it gets viewport=mobile while every other Navigation case stays desktop -->
    <test name="MobileNavigation">
        <parameter name="viewport" value="mobile"/>
        <classes>
            <class name="com.gratis.tests.NavigationTests">
                <methods>
                    <include name="mobileHamburgerMenuDrilldown"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Module 3: Search, Sorting & Filtering -->
    <test name="SearchAndFiltering">
        <classes>
            <class name="com.gratis.tests.SearchTests"/>
            <class name="com.gratis.tests.FilterSortTests"/>
        </classes>
    </test>

    <!-- Module 4: Product Catalog (PLP/PDP) -->
    <test name="Catalog">
        <classes>
            <class name="com.gratis.tests.CatalogTests"/>
        </classes>
    </test>

    <!-- Module 5: Cart -->
    <test name="Cart">
        <classes>
            <class name="com.gratis.tests.CartTests"/>
        </classes>
    </test>

    <!-- Module 6: Checkout & Payment (run serially - these mutate a real cart/order state) -->
    <test name="Checkout" parallel="false">
        <classes>
            <class name="com.gratis.tests.CheckoutTests"/>
            <class name="com.gratis.tests.OrderTests"/>
        </classes>
    </test>

</suite>
